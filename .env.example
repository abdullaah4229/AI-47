# Copy this file to .env and fill in the values. Never commit .env.

# Long random string. Generate one with:  openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Local SQLite database file (no hosted database, no recurring fees)
DATABASE_URI=file:./data/ai742.db

# The public address of the site (used for SEO links). Local: http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- Email (contact form notifications) ----
# Where new leads are sent:
NOTIFY_EMAIL=abdullaah4229@gmail.com
# Gmail sending account. SMTP_PASS must be a Gmail *App Password* (not your normal password):
# Google Account → Security → 2-Step Verification (turn on) → App passwords → create one for "AI 742 website".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=abdullaah4229@gmail.com
SMTP_PASS=
SMTP_FROM=abdullaah4229@gmail.com
